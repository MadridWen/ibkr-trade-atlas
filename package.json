{
  "name": "ibkr-trade-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "IBKR CSV trade journal with daily candlesticks, FIFO P&L and optional yuan cost reporting",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/compile.mjs && node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "predev": "node scripts/compile.mjs",
    "dev": "node scripts/dev.mjs",
    "pretest": "node scripts/compile.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
